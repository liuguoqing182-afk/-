FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=请只放在本机环境变量中
FEISHU_CHAT_ID=正式发布群的oc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_TEST_CHAT_ID=测试群的oc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AM_INSPECT_UID=用于请求AM配置接口的测试用户UID

# 可选，默认值如下
AM_PUBLISH_SETTLE_MS=8000
AM_INSPECT_DATA_DIR=data
AM_INSPECT_TEST_DATA_DIR=data-test

# 正式群历史消息只读轮询（默认每小时一次）
FEISHU_HISTORY_POLL_INTERVAL_MS=3600000
FEISHU_HISTORY_INITIAL_LOOKBACK_MS=3600000
FEISHU_HISTORY_OVERLAP_MS=60000
FEISHU_HISTORY_POLL_STATE_PATH=data/feishu-history-poller-state.json
FEISHU_HISTORY_MESSAGE_ID_STATE_PATH=data/feishu-history-processed-message-ids.json
FEISHU_HISTORY_REPORT_OUTBOX_PATH=data/feishu-history-report-outbox.json

# 主动发布 Webhook（独立于飞书长连接监听器）
AM_WEBHOOK_SECRET=请使用至少32字节的随机共享密钥
AM_WEBHOOK_HOST=127.0.0.1
AM_WEBHOOK_PORT=8787
AM_WEBHOOK_DATA_DIR=data-webhook
AM_WEBHOOK_MAX_SKEW_SECONDS=300
AM_WEBHOOK_MAX_BODY_BYTES=1048576
AM_WEBHOOK_WORKER_ENABLED=true
AM_WEBHOOK_FEISHU_CHAT_ID=默认使用FEISHU_CHAT_ID，也可显式指定
AM_WEBHOOK_POLL_INTERVAL_MS=1000
AM_WEBHOOK_INSPECTION_ATTEMPTS=3
AM_WEBHOOK_REPORT_ATTEMPTS=5
AM_WEBHOOK_RETRY_BASE_MS=1000
AM_WEBHOOK_SETTLE_MS=600000
